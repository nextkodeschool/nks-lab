# PostgreSQL settings for Docker Compose
POSTGRES_DB=nextkode
POSTGRES_USER=nextkode
POSTGRES_PASSWORD=change_me

# Backend settings
# For Docker Compose, DATABASE_URL is generated in docker-compose.yml.
# For local no-Docker development, use SQLite:
DATABASE_URL=sqlite:///./local-dev.db
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# Demo users seeded by the backend at startup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
STUDENT1_USERNAME=student1
STUDENT1_PASSWORD=student@1
STUDENT2_USERNAME=student2
STUDENT2_PASSWORD=student@2

# Local development ports
BACKEND_PORT=8000
FRONTEND_PORT=5147
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
